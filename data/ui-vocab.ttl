@prefix ui:     <http://www.w3.org/ns/ui#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <http://schema.org/> .

##########################
# UI Configuration Terms #
##########################

ui:ColorScheme a rdfs:Class ; rdfs:isDefinedBy <> ; rdfs:label "Color scheme" .
ui:LightColorScheme  a ui:ColorScheme ; rdfs:label "Light"  .
ui:DarkColorScheme   a ui:ColorScheme ; rdfs:label "Dark"   .
ui:SystemColorScheme a ui:ColorScheme ; rdfs:label "System" .
ui:colorScheme a rdf:Property ; rdfs:isDefinedBy <> ;
  rdfs:label   "color scheme" ;
  rdfs:comment "Preferred page color scheme; the value is a ui:ColorScheme instance, e.g. ui:DarkColorScheme." ;
  rdfs:range   ui:ColorScheme .

ui:FontSize a rdfs:Class ; rdfs:isDefinedBy <> ; rdfs:label "Font size" .
ui:SmallFont  a ui:FontSize ; rdfs:label "Small"  .
ui:MediumFont a ui:FontSize ; rdfs:label "Medium" .
ui:LargeFont  a ui:FontSize ; rdfs:label "Large"  .
ui:fontSize a rdf:Property ; rdfs:isDefinedBy <> ;
  rdfs:label   "font size" ;
  rdfs:comment "Preferred page font size; the value is a ui:FontSize instance, e.g. ui:SmallFont." ;
  rdfs:range   ui:FontSize .

ui:EditorKeys a rdfs:Class ; rdfs:isDefinedBy <> ; rdfs:label "Editor keys" .
ui:DefaultKeys a ui:EditorKeys ; rdfs:label "Default" .
ui:EmacsKeys   a ui:EditorKeys ; rdfs:label "Emacs"   .
ui:VimKeys     a ui:EditorKeys ; rdfs:label "Vim"     .
ui:editorKeys a rdf:Property ; rdfs:isDefinedBy <> ;
  rdfs:label   "editor keys" ;
  rdfs:comment "Preferred editor keybindings; the value is a ui:EditorKeys instance, e.g. ui:VimKeys." ;
  rdfs:range   ui:EditorKeys .

ui:Orientation a rdfs:Class ; rdfs:isDefinedBy <> ; rdfs:label "Orientation" .
ui:Horizontal a ui:Orientation ; rdfs:label "Horizontal" .
ui:Vertical   a ui:Orientation ; rdfs:label "Vertical"   .
ui:orientation a rdf:Property ; rdfs:isDefinedBy <> ;
  rdfs:label   "orientation" ;
  rdfs:comment "Menu layout direction; the value is a ui:Orientation instance (ui:Horizontal default, or ui:Vertical)." ;
  rdfs:range   ui:Orientation .

ui:windowX a rdf:Property ; rdfs:isDefinedBy <> ;
  rdfs:label   "window x" ;
  rdfs:comment "The x (horizontal) screen coordinate, in pixels, of an element or window's top-left corner." ;
  rdfs:range   xsd:integer .

ui:windowY a rdf:Property ; rdfs:isDefinedBy <> ;
  rdfs:label   "window y" ;
  rdfs:comment "The y (vertical) screen coordinate, in pixels, of  an element or window's top-left corner." ;
  rdfs:range   xsd:integer .

ui:ignorePattern a rdf:Property ; rdfs:isDefinedBy <> ;
  rdfs:label   "ignore pattern" ;
  rdfs:comment "A filename/path glob pattern hidden from listings (e.g. \"*~\", \".*\"); repeatable." ;
  rdfs:range   xsd:string .

ui:Region a rdfs:Class ; rdfs:isDefinedBy <> ; rdfs:label "Region" .
ui:Inline   a ui:Region ; rdfs:label "Inline"   .
ui:Element  a ui:Region ; rdfs:label "Element"  .
ui:Modal    a ui:Region ; rdfs:label "Modal"    .
ui:Floating a ui:Region ; rdfs:label "Floating" .
ui:Window   a ui:Region ; rdfs:label "Window"   .
ui:Tab      a ui:Region ; rdfs:label "Tab"      .
ui:Dropdown a ui:Region ; rdfs:label "Dropdown" .
ui:region a rdf:Property ; rdfs:isDefinedBy <> ;
  rdfs:label   "region" ;
  rdfs:comment "Where an item's rendered content is placed; the value is a ui:Region instance e.g. ui:Modal." ;
  rdfs:range   ui:Region .

###############################
# General Configuration Terms #
###############################

ui:TemperatureUnit a rdfs:Class ; rdfs:isDefinedBy <> ; rdfs:label "Temperature unit" .
ui:Fahrenheit a ui:TemperatureUnit ; rdfs:label "Fahrenheit" .
ui:Celsius    a ui:TemperatureUnit ; rdfs:label "Celsius"    .
ui:temperatureUnit a rdf:Property ; rdfs:isDefinedBy <> ;
  rdfs:label   "temperature unit" ;
  rdfs:comment "Display unit(s) for temperature; repeatable, each value a ui:TemperatureUnit instance. Listing both ui:Fahrenheit and ui:Celsius shows both." ;
  rdfs:range   ui:TemperatureUnit .

ui:publicPort a rdf:Property ; rdfs:isDefinedBy <> ;
  rdfs:label   "public port" ;
  rdfs:comment "TCP port the public routing server (the origin clients talk to) listens on." ;
  rdfs:range   xsd:integer .

ui:privatePort a rdf:Property ; rdfs:isDefinedBy <> ;
  rdfs:label   "private port" ;
  rdfs:comment "TCP port the private server, behind the router, listens on." ;
  rdfs:range   xsd:integer .

ui:proxyPort a rdf:Property ; rdfs:isDefinedBy <> ;
  rdfs:label   "proxy port" ;
  rdfs:comment "TCP port the CORS proxy listens on." ;
  rdfs:range   xsd:integer .

ui:proxy a rdf:Property ; rdfs:isDefinedBy <> ;
  rdfs:label   "proxy" ;
  rdfs:comment "URL prefix that wraps a target URL for CORS proxying; the target is URI-encoded onto the end." ;
  rdfs:range   xsd:string .

##############
# MENU TERMS #
##############

ui:Menu a rdfs:Class ; rdfs:label "Menu" ; rdfs:isDefinedBy <> ;
  rdfs:comment "A navigable menu or tab set; its ui:parts is an ordered list of references to ui:Plugin entries (or nested ui:Menus). Menus may also inline ui:Link/ui:Component/ui:Command items directly." .

ui:Link a rdfs:Class ; rdfs:label "Link" ; rdfs:isDefinedBy <> ;
  rdfs:comment "An external app/URL. As a schema:additionalType value it marks the kind of a ui:Plugin entry; as an rdf:type it is the inline menu-item form. Either way the single schema:url payload is the URL to open (ui:contents may replace it with inline HTML)." .

ui:Component a rdfs:Class ; rdfs:label "Component" ; rdfs:isDefinedBy <> ;
  rdfs:comment "A mountable custom element, configured with ui:attribute pairs. As a schema:additionalType value it marks the kind of a ui:Plugin entry; as an rdf:type it is the inline menu-item form. Either way the single schema:url payload is the defining ES module — the element tag derives from its filename." .

ui:Plugin a rdfs:Class ; rdfs:label "Plugin" ; rdfs:isDefinedBy <> ;
  rdfs:comment "One editable plugin entry: the description of an available capability — an external app (ui:Link), a mountable custom element (ui:Component), or a host command (ui:Command) — discriminated by a REQUIRED schema:additionalType, with a single schema:url payload the kind interprets. The same node is the catalog card and, when referenced from a ui:Menu's parts list, the mounted item; being referenced is what makes it in use." .

ui:Command a rdfs:Class ; rdfs:label "Command" ; rdfs:isDefinedBy <> ;
  rdfs:comment "A host-app command. Its entry's schema:url is a fragment IRI in the host's command registry document; the hyphen-free fragment (the spelling that distinguishes a key from a custom-element tag) is dispatched as a sol-command event. The registry is an allow-list, so an unregistered key is a no-op. No code is loaded or executed from RDF." .

ui:icon a rdf:Property ; rdfs:label "icon" ; rdfs:isDefinedBy <> ;
  rdfs:comment "Optional icon URL shown for a menu item." .

ui:hoverTitle a rdf:Property ; rdfs:label "hover title" ; rdfs:isDefinedBy <> ;
  rdfs:comment "Optional hover/advisory text for a menu item or component, with HTML title-attribute semantics." ;
  rdfs:range   xsd:string .

ui:attribute a rdf:Property ; rdfs:label "attribute" ; rdfs:isDefinedBy <> ;
  rdfs:comment "An attribute passed to a ui:Component's element (or emitted on a ui:Layout region's element), given as a schema:PropertyValue (schema:name + schema:value)." ;
  rdfs:range   schema:PropertyValue .

################
# LAYOUT TERMS #
################

ui:Layout a rdfs:Class ; rdfs:label "Layout" ; rdfs:isDefinedBy <> ;
  rdfs:comment "A rectangular page/screen arrangement whose ui:parts render SIMULTANEOUSLY — stacked or side by side per ui:orientation — unlike a ui:Menu, whose parts are alternatives the user switches between. Parts are nested ui:Layout regions and/or ui:Component leaves; an empty layout is a placeholder pane other items can target. May carry ui:attribute pairs (class, aria-label, id) emitted on the region's element, and a schema:additionalType naming a schema.org web-page-element class (e.g. schema:SiteNavigationElement) that selects the emitted semantic HTML tag." .

ui:layout a rdf:Property ; rdfs:isDefinedBy <> ;
  rdfs:label   "layout" ;
  rdfs:comment "Links a thing (e.g. a schema:WebApplication) to its root ui:Layout." ;
  rdfs:range   ui:Layout .

ui:columns a rdf:Property ; rdfs:isDefinedBy <> ;
  rdfs:label   "columns" ;
  rdfs:comment "On a ui:Layout: render the parts as a grid with this many columns instead of a single flex row/column." ;
  rdfs:range   xsd:integer .


