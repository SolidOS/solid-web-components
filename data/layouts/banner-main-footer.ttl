@prefix : <#> .
@prefix ui: <http://www.w3.org/ns/ui#> .
@prefix schema: <http://schema.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Structural layout: banner, content, footer. Theme chrome ships in place
# (banner ☰, page-content include, footer include) — ordinary removable
# elements in the builder.

:Layout a ui:Layout ;
  ui:label "Banner + main + footer" ;
  ui:orientation ui:Vertical ;
    schema:itemListElement :Layout-Banner, :Layout-Main, :Layout-Footer .

:Banner a ui:Layout ;
  ui:label "Banner" ;
  schema:additionalType schema:WPHeader ;
  ui:orientation ui:Horizontal ;
  schema:additionalProperty [ schema:name "class" ; schema:value "app-banner" ] ;
    schema:itemListElement :Banner-more .

:more a ui:Component ;
  ui:label "☰ menu" ;
  rdfs:comment "Theme chrome: Help / Theme / Text size from the app's More menu" ;
  schema:url </node_modules/sol-components/web/sol-dropdown-button.js> ;
  schema:additionalProperty [ schema:name "label" ; schema:value "☰" ] ,
               [ schema:name "from-rdf" ; schema:value "app-menu.ttl#More" ] .

:Main a ui:Layout ;
  ui:label "Content" ;
  schema:additionalProperty [ schema:name "class" ; schema:value "app-panels" ] ;
    schema:itemListElement :Main-content .

:content a ui:Component ;
  ui:label "Page content" ;
  rdfs:comment "The page body, loaded from the app's own content.html" ;
  schema:url </node_modules/sol-components/web/sol-include.js> ;
  schema:additionalProperty [ schema:name "source" ; schema:value "content.html" ] ,
               [ schema:name "trusted" ; schema:value "" ] .

:Footer a ui:Layout ;
  ui:label "Footer" ;
  schema:additionalType schema:WPFooter ;
  schema:additionalProperty [ schema:name "class" ; schema:value "app-footer" ] ;
    schema:itemListElement :Footer-footer-content .

:footer-content a ui:Component ;
  ui:label "Footer content" ;
  rdfs:comment "The footer, loaded from the app's own footer.html" ;
  schema:url </node_modules/sol-components/web/sol-include.js> ;
  schema:additionalProperty [ schema:name "source" ; schema:value "footer.html" ] ,
               [ schema:name "trusted" ; schema:value "" ] .

:Layout-Banner a schema:ListItem; schema:item :Banner; schema:position 1.
:Layout-Main a schema:ListItem; schema:item :Main; schema:position 2.
:Layout-Footer a schema:ListItem; schema:item :Footer; schema:position 3.

:Banner-more a schema:ListItem; schema:item :more; schema:position 1.

:Main-content a schema:ListItem; schema:item :content; schema:position 1.

:Footer-footer-content a schema:ListItem; schema:item :footer-content; schema:position 1.
