@prefix ui:     <http://www.w3.org/ns/ui#> .
@prefix schema: <http://schema.org/> .
@prefix acl:    <http://www.w3.org/ns/auth/acl#> .

# Fixture for scripts/verify-menu-serialize.mjs — a copy of data-kitchen's
# real menu shape: a menu with components, a nested submenu, an acl-gated
# item, and PANTRY subjects (#Forum, #Chat) defined but referenced from no
# menu's membership. The pantry must survive every rewrite.

<#MainMenu> a ui:Menu ; ui:label "data-kitchen" ;
  ui:orientation ui:Horizontal ;
  schema:itemListElement <#MainMenu-Home>, <#MainMenu-Podz>, <#MainMenu-SolidResources> .

<#MainMenu-Home> a schema:ListItem ; schema:item <#Home> ; schema:position 1 .
<#MainMenu-Podz> a schema:ListItem ; schema:item <#Podz> ; schema:position 2 .
<#MainMenu-SolidResources> a schema:ListItem ; schema:item <#SolidResources> ; schema:position 3 .

<#Home> a ui:Component ; ui:label "Home" ;
  schema:url <web/sol-include.js> ;
  schema:additionalProperty
    [ schema:name "source"  ; schema:value "pages/home.html" ] ,
    [ schema:name "trusted" ; schema:value "true" ] .

<#Podz> a ui:Component ; ui:label "Podz" ;
  schema:url <plugins/podz/dk-podz.js> ;
  acl:mode acl:Write .

<#SolidResources> a ui:Menu ; ui:label "SolidResources" ;
  schema:itemListElement <#SolidResources-Website>, <#SolidResources-Faq> .

<#SolidResources-Website> a schema:ListItem ; schema:item <#Website> ; schema:position 1 .
<#SolidResources-Faq> a schema:ListItem ; schema:item <#Faq> ; schema:position 2 .

<#Website> a ui:Link ; ui:label "Website" ;
  schema:url "https://solidproject.org" .

<#Faq> a ui:Link ; ui:label "FAQ" ;
  schema:url "https://solidproject.org/FAQ" .

<#Forum> a ui:Link ; ui:label "Forum" ;
  schema:url "https://forum.solidproject.org" .

<#Chat> a ui:Link ; ui:label "Chat" ;
  schema:url "https://matrix.to/#/#solid-practitioners:matrix.org/" .
