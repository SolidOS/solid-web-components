
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX ui: <http://www.w3.org/ns/ui#>
PREFIX wd: <http://www.wikidata.org/entity/>

shape <#PodSettingsFileShape> -> wd:Q1193846 {
    foaf:primaryTopic [1..1] @<#PodSettingsShape> .
}
shape <#PodSettingsShape> {
    ui:ignorePattern xsd:string % sh:name "Hide paths" ; sh:description "Filename/path glob patterns hidden from the pod browser (e.g. \"*~\", \".*\", \"#*#\"). One per value — add as many as you like." % .
}

<> owl:imports <../data/ui-vocab.ttl> .

