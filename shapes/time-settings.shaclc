
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX schema: <http://schema.org/>
PREFIX wd: <http://www.wikidata.org/entity/>

shape <#TimeSettingsFileShape> -> wd:Q1193846 {
    foaf:primaryTopic [1..1] @<#TimeSettingsShape> .
}
shape <#TimeSettingsShape> {
    schema:timezone xsd:string [1..1] % sh:name "Extra timezone (IANA name)" ; sh:description "An IANA timezone identifier like 'Asia/Kolkata' or 'America/New_York'. sol-time always renders local + UTC; this adds a third clock for the named zone." % .
}


