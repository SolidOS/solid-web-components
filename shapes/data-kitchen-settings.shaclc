
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX schema: <http://schema.org/>
PREFIX ui: <http://www.w3.org/ns/ui#>
PREFIX wd: <http://www.wikidata.org/entity/>

shape <#DataKitchenSettingsFileShape> -> wd:Q1193846 {
    foaf:primaryTopic [1..1] @<#DataKitchenSettingsShape> .
}
shape <#DataKitchenSettingsShape> {
    ui:colorScheme ui:ColorScheme [0..1] % sh:name "Color scheme" % .
    ui:fontSize ui:FontSize [0..1] % sh:name "Font size" % .
    schema:softwareHelp xsd:string [0..1] % sh:name "Help document" ; sh:description "Path or URL of the help document the ? button opens when the active plugin doesn't supply its own." % .
}

<> owl:imports <../data/ui-vocab.ttl> .

