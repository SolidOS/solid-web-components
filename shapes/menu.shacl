@prefix : <#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ui: <http://www.w3.org/ns/ui#> .
@prefix schema: <http://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Menu + plugin-entry shapes (mixin rewrite, 2026-07-19). Design rules:
#   - card/settings metadata lives ONLY on the ui:Plugin catalog entry; a
#     bare ui:Link / ui:Component inline item carries just its working
#     fields (retired spellings — acl:mode, ui:region, ui:hoverTitle,
#     ui:contents, per-class metadata copies — are GONE from the contract)
#   - each item kind owns its complete schema:url definition, REQUIRED;
#     :PluginShape's sh:xone discriminates on schema:additionalType and
#     DELEGATES to the kind shape via sh:node
#   - :CommandShape has no sh:targetClass on purpose: registry fragments
#     (data-kitchen-commands.ttl) are bare `a ui:Command` documentation and
#     must never meet the strict entry contract
#   - shared blocks are node-level mixins (:IconMixin, :AttributedMixin) —
#     the forms resolver expands node-level sh:node refs (dedup by path)
#   - property order here IS the edit-form field order

:MenuShape
  a sh:NodeShape ;
  sh:targetClass ui:Menu ;
  sh:property [
    sh:path ui:label ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:name "label" ;
    sh:description "The display label for the menu" ;
  ] ;
  sh:property [
    sh:path schema:itemListElement ;
    sh:nodeKind sh:IRI ;
    sh:name "entries" ;
    sh:description "Menu membership — one triple per member. A CURATED menu points at positioned schema:ListItem placement wrappers; an unordered SET (e.g. the catalog #Available) points straight at the members." ;
    sh:or (
      [ sh:node :OrderedItemShape ]
      [ sh:node :UnorderedItemShape ]
    ) ;
  ] ;
  sh:property [
    sh:path schema:itemListOrder ;
    sh:maxCount 1 ;
    sh:in ( schema:ItemListOrderAscending ) ;
    sh:name "order" ;
    sh:description "Declares that entries render sorted by their wrappers' schema:position, ascending. Present on curated menus; absent on unordered sets." ;
  ] ;
  sh:property [
    sh:path ui:orientation ;
    sh:maxCount 1 ;
    sh:in ( ui:Horizontal ui:Vertical ) ;
    sh:name "orientation" ;
    sh:description "Layout orientation: ui:Horizontal (default) or ui:Vertical" ;
  ] .

# THE unified catalog entry: one editable ui:Plugin node is the manifest,
# the catalog/pantry card, AND the mounted item (menus reference it). The
# REQUIRED schema:additionalType picks the kind; the payload contract is
# DELEGATED to the matching kind shape, which owns its schema:url in full.
:PluginShape
  a sh:NodeShape ;
  sh:targetClass ui:Plugin ;
  sh:node :IconMixin, :AttributedMixin ;
  sh:property [
    sh:path schema:additionalType ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( ui:Link ui:Component ui:Command ) ;
    sh:name "kind" ;
    sh:description "REQUIRED discriminator: what kind of capability this entry describes — ui:Link (external URL), ui:Component (custom element), ui:Command (host command key)." ;
  ] ;
  sh:property [
    sh:path ui:label ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:name "label" ;
    sh:description "Display name — the card title AND the menu entry text (one label everywhere)." ;
  ] ;
  sh:property [
    sh:path dcterms:source ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:name "manifest" ;
    sh:description "Provenance: the flat manifest doc this entry was generated from (Customize's delete removes it too)." ;
  ] ;
  sh:property [
    sh:path schema:description ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:name "description" ;
    sh:description "User-facing card blurb" ;
  ] ;
  sh:property [
    sh:path dcterms:publisher ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:name "publisher" ;
    sh:description "Who publishes the plugin (card byline)" ;
  ] ;
  sh:property [
    sh:path dcterms:subject ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:class skos:Concept ] ) ;
    sh:name "topics" ;
    sh:description "Topic categories (Customize tabs) — plain strings or skos:Concept nodes" ;
  ] ;
  sh:property [
    sh:path dcterms:conformsTo ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:name "shape" ;
    sh:description "SHACL shape the plugin's settings/data conform to" ;
  ] ;
  sh:property [
    sh:path dcterms:references ;
    sh:nodeKind sh:IRI ;
    sh:name "data" ;
    sh:description "Default/seed data document(s) the plugin starts from" ;
  ] ;
  sh:property [
    sh:path schema:softwareHelp ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:name "help" ;
    sh:description "USER online help (not developer docs)" ;
  ] ;
  sh:xone (
    [
      sh:property [ sh:path schema:additionalType ; sh:hasValue ui:Link ] ;
      sh:node :LinkShape ;
    ]
    [
      sh:property [ sh:path schema:additionalType ; sh:hasValue ui:Component ] ;
      sh:node :ComponentShape ;
    ]
    [
      sh:property [ sh:path schema:additionalType ; sh:hasValue ui:Command ] ;
      sh:node :CommandShape ;
    ]
  ) ;
  sh:message "A ui:Plugin's payload is its kind shape's schema:url: the URL a Link opens, an ES module with a tag-shaped filename (Component), or a registry fragment IRI with a hyphen-free key (Command)" .

# A placement wrapper: WHERE one member sits in ONE menu — position lives on
# the placement, never the shared member. Reorder = swap two positions.
:OrderedItemShape
  a sh:NodeShape ;
  sh:class schema:ListItem ;
  sh:property [
    sh:path schema:item ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:node :UnorderedItemShape ;
    sh:name "item" ;
    sh:description "The member this placement mounts — a ui:Plugin entry, an inline item, or a nested ui:Menu." ;
  ] ;
  sh:property [
    sh:path schema:position ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
    sh:name "position" ;
    sh:description "Sort key within this menu (ascending; sequential 1..n by convention)." ;
  ] .

# A direct member (unordered sets), and the target of every wrapper's
# schema:item. No targetClass: bound only via the membership paths, so the
# label rule applies to members REACHABLE from a menu but never to
# free-standing nodes (e.g. ci manifest entries, whose label is optional).
:UnorderedItemShape
  a sh:NodeShape ;
  sh:or (
    [ sh:class ui:Plugin ]
    [ sh:class ui:Link ]
    [ sh:class ui:Component ]
    [ sh:class ui:Command ]
    [ sh:class ui:Menu ]
  ) ;
  sh:property [
    sh:path ui:label ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:name "label" ;
    sh:message "Every menu member must have a ui:label" ;
    sh:description "Display label — required for every member reachable from a ui:Menu" ;
  ] .

:LinkShape
  a sh:NodeShape ;
  sh:targetClass ui:Link ;
  sh:node :IconMixin ;
  sh:property [
    sh:path ui:label ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:name "label" ;
    sh:description "The display label for the link" ;
  ] ;
  sh:property [
    sh:path schema:url ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:or ( [ sh:nodeKind sh:IRI ] [ sh:datatype xsd:string ] ) ;
    sh:name "url" ;
    sh:description "The URL the link opens — an IRI or a URL string" ;
  ] .

:ComponentShape
  a sh:NodeShape ;
  sh:targetClass ui:Component ;
  sh:node :IconMixin, :AttributedMixin ;
  sh:property [
    sh:path ui:label ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:name "label" ;
    sh:description "Display name. Optional here (manifest entries may omit it); members reachable from a ui:Menu must have one (:UnorderedItemShape)" ;
  ] ;
  sh:property [
    sh:path schema:url ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:pattern "/[a-z][a-z0-9]*(-[a-z0-9]+)+(\\.esm|\\.min)?\\.js$" ;
    sh:name "module URL" ;
    sh:description "The ES module that defines the element; the element tag derives from the filename (filename IS the tag)." ;
  ] .

# NO sh:targetClass on purpose (see header): this is the ENTRY contract for
# kind-Command plugins, reached only through :PluginShape's sh:xone. Bare
# `a ui:Command` registry fragments are documentation and stay unbound.
:CommandShape
  a sh:NodeShape ;
  sh:property [
    sh:path schema:url ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:pattern "#[A-Za-z][A-Za-z0-9]*$" ;
    sh:name "command URL" ;
    sh:description "A fragment IRI in the host app's command registry document; the hyphen-free fragment is the command key." ;
  ] .

# ── mixins ────────────────────────────────────────────────────────────────
:IconMixin
  a sh:NodeShape ;
  sh:property [
    sh:path ui:icon ;
    sh:maxCount 1 ;
    sh:or ( [ sh:nodeKind sh:IRI ] [ sh:datatype xsd:string ] ) ;
    sh:name "icon" ;
    sh:description "Icon: a URL (IRI or string) painted as an image, or an emoji/text string" ;
  ] .

:AttributedMixin
  a sh:NodeShape ;
  sh:property [
    sh:path ui:attribute ;
    sh:node :PropertyValueShape ;
    sh:name "attribute" ;
    sh:description "Attributes for the element (or args for the command) as schema:PropertyValue pairs, incl. the deployment conventions: region (placement keyword) and if-logged-in \"\" (owner gate)" ;
  ] .

:PropertyValueShape
  a sh:NodeShape ;
  sh:property [
    sh:path schema:name ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:name "name" ;
    sh:description "Attribute name" ;
  ] ;
  sh:property [
    sh:path schema:value ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:name "value" ;
    sh:description "Attribute value (datatype-free; JSON-LD manifests always emit strings)" ;
  ] .
