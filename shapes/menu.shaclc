PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX schema: <http://schema.org/>
PREFIX ui: <http://www.w3.org/ns/ui#>

shape <#MenuShape> -> ui:Menu {
    ui:label xsd:string [1..1] %
        sh:name "label" ; sh:description "The display label for the menu"
    % .
    schema:itemListElement IRI @<#OrderedItemShape>|@<#UnorderedItemShape> %
        sh:name "menu items" ; sh:description "An ordered or unordered list of menu items."
    % .
    schema:itemListOrder [0..1] in=[schema:ItemListOrderAscending] %
        sh:name "order" ; sh:description "If present, the list is ordered."
    % .
    ui:orientation [0..1] in=[ui:Horizontal ui:Vertical] %
        sh:name "orientation" ; sh:description "ui:Horizontal or ui:Vertical menu layout"
    % .
}

shape <#OrderedItemShape> {
    class=schema:ListItem .
    schema:item IRI [1..1] @<#UnorderedItemShape> %
        sh:name "item" ; sh:description "An ordered menu item."
    % .
    schema:position xsd:integer [1..1] %
        sh:name "position" ; sh:description "Sort order number within this menu."
    % .
}

shape <#UnorderedItemShape> {
    class=ui:Plugin|class=ui:Link|class=ui:Component|class=ui:Command|class=ui:Menu .
    ui:label xsd:string [1..1] %
        sh:name "label" ; sh:description "Display label"
    % .
}

shape <#PluginShape> -> ui:Plugin ;
    sh:node <#IconMixin>, <#AttributedMixin> ;
    sh:xone ([
        sh:property [
            sh:path schema:additionalType ;
            sh:hasValue ui:Link
        ] ;
        sh:node <#LinkShape>
    ] [
        sh:property [
            sh:path schema:additionalType ;
            sh:hasValue ui:Component
        ] ;
        sh:node <#ComponentShape>
    ] [
        sh:property [
            sh:path schema:additionalType ;
            sh:hasValue ui:Command
        ] ;
        sh:node <#CommandShape>
    ]) {
    schema:additionalType [1..1] in=[ui:Link ui:Component ui:Command] %
        sh:name "menu item kind" ; sh:description "ui:Link (external URL), ui:Component (custom element), or ui:Command (host command key)."
    % .
    ui:label xsd:string [1..1] %
        sh:name "label" ; sh:description "Display name for menus, buttons, etc."
    % .
    ui:region [0..1] in=[ui:Inline ui:Element ui:Modal ui:Floating ui:Window ui:Tab ui:Dropdown] %
        sh:name "region" ; sh:description "Where the plugin's content is placed — a ui:Region instance, e.g. ui:Tab or ui:Modal."
    % .
    dcterms:source IRI [0..1] %
        sh:name "manifest" ; sh:description "Provenance: the flat manifest doc this entry was generated from."
    % .
    schema:description xsd:string [0..1] %
        sh:name "description" ; sh:description "User-facing plugin description."
    % .
    dcterms:publisher xsd:string [0..1] %
        sh:name "publisher" ; sh:description "Publisher/maintainer of the plugin."
    % .
    schema:keywords xsd:string %
        sh:name "topics" ; sh:description "Topic categories (Customize tabs) — one string per topic"
    % .
    dcterms:conformsTo IRI [0..1] %
        sh:name "shape" ; sh:description "SHACL shape the plugin's settings/data conform to. Used to auto-generate forms."
    % .
    dcterms:references IRI %
        sh:name "data" ; sh:description "Plugin's data/settings document."
    % .
    schema:softwareHelp IRI [0..1] %
        sh:name "help" ; sh:description "Plugin help page."
    % .
}

shape <#IconMixin> {
    ui:icon [0..1] IRI|xsd:string %
        sh:name "icon" ; sh:description "URL of an image or emoji/text string"
    % .
}

shape <#AttributedMixin> {
    ui:attribute @<#PropertyValueShape> %
        sh:name "attribute" ; sh:description "plugin parameter key/value pairs"
    % .
}

shape <#LinkShape> -> ui:Link ;
    sh:node <#IconMixin> {
    ui:label xsd:string [1..1] %
        sh:name "label" ; sh:description "The display label for the link"
    % .
    schema:url [1..1] IRI|xsd:string %
        sh:name "url" ; sh:description "The URL the link opens — an IRI or a URL string"
    % .
}

shape <#ComponentShape> -> ui:Component ;
    sh:node <#IconMixin>, <#AttributedMixin> {
    ui:label xsd:string [0..1] %
        sh:name "label" ; sh:description "Display name for menus, buttons etc."
    % .
    schema:url IRI [1..1] pattern="/[a-z][a-z0-9]*(-[a-z0-9]+)+(\\.esm|\\.min)?\\.js$" %
        sh:name "module URL" ; sh:description "The ES module that defines the custom element."
    % .
}

shape <#CommandShape> {
    schema:url IRI [1..1] pattern="#[A-Za-z][A-Za-z0-9]*$" %
        sh:name "command URL" ; sh:description "A fragment IRI in the host app's command registry document which points to one of the app's commands."
    % .
}

shape <#PropertyValueShape> {
    schema:name xsd:string [1..1] %
        sh:name "name" ; sh:description "Attribute name"
    % .
    schema:value [1..1] %
        sh:name "value" ; sh:description "Attribute value"
    % .
}
