@prefix :     <#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ui:   <http://www.w3.org/ns/ui#> .
@prefix schema: <http://schema.org/> .

<>
  owl:imports <../data/ui-vocab.ttl> .


:DataKitchenSettingsFileShape
  a sh:NodeShape ;
  sh:targetClass wd:Q1193846 ;
  sh:property [
    sh:path foaf:primaryTopic ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:node :DataKitchenSettingsShape ;
  ] .

# NOTE: the settings doc also carries ui:proxy (the CORS-proxy URL prefix
# components read at runtime), but the proxy is configured via its PORT in
# the Pivot settings group — so the form deliberately does not surface the
# URL here.
:DataKitchenSettingsShape
  a sh:NodeShape ;

  sh:property [
    sh:path ui:colorScheme ;
    sh:class ui:ColorScheme ;
    sh:maxCount 1 ;
    sh:name "Color scheme" ;
  ] ,
  [
    sh:path ui:fontSize ;
    sh:class ui:FontSize ;
    sh:maxCount 1 ;
    sh:name "Font size" ;
  ] ,
  [
    sh:path schema:softwareHelp ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:name "Help document" ;
    sh:description "Path or URL of the help document the ? button opens when the active plugin doesn't supply its own." ;
  ] .
