@prefix ui: <http://www.w3.org/ns/ui#> .
@prefix schema: <http://schema.org/> .

<#MainMenu> a ui:Menu; ui:label "demo-menu" ;
  ui:orientation ui:Horizontal ;
  schema:itemListElement <#MainMenu-Home>, <#MainMenu-DataMenu>, <#MainMenu-About> .

<#MainMenu-Home> a schema:ListItem ; schema:item <#Home> ; schema:position 1 .
<#MainMenu-DataMenu> a schema:ListItem ; schema:item <#DataMenu> ; schema:position 2 .
<#MainMenu-About> a schema:ListItem ; schema:item <#About> ; schema:position 3 .

<#Home> a ui:Link; ui:label "Home" ;
  ui:contents "<h2>Welcome</h2><p>This is the home page, rendered from a <code>ui:contents</code> literal.</p>" .

<#DataMenu> a ui:Menu; ui:label "Data" ;
  schema:itemListElement <#DataMenu-SampleTable>, <#DataMenu-SampleTriples> .

<#DataMenu-SampleTable> a schema:ListItem ; schema:item <#SampleTable> ; schema:position 1 .
<#DataMenu-SampleTriples> a schema:ListItem ; schema:item <#SampleTriples> ; schema:position 2 .

<#SampleTable> a ui:Component; ui:label "People (table)" ;
  schema:url <../../web/sol-query.js> ;
  schema:additionalProperty
    [ schema:name "endpoint" ; schema:value <./sample-data.ttl> ] ,
    [ schema:name "sparql" ; schema:value """PREFIX schema: <http://schema.org/>
      SELECT ?name ?gender ?location WHERE {
        ?p a schema:Person ;
           schema:name ?name ;
           schema:gender ?gender ;
           schema:homeLocation ?location .
      } LIMIT 3""" ] ,
    [ schema:name "view" ; schema:value "table" ] .

<#SampleTriples> a ui:Link; ui:label "People (raw triples)" ;
  schema:url <./sample-data.ttl> .

<#About> a ui:Component; ui:label "About" ;
  schema:url <../../web/sol-include.js> ;
  schema:additionalProperty
    [ schema:name "source" ; schema:value "./sample-buttons.html" ] ,
    [ schema:name "trusted" ; schema:value "" ] .
