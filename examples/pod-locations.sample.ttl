@prefix schema: <http://schema.org/>.

<#Locations> a schema:ItemList;
    schema:name "Pod locations";
    schema:itemListOrder schema:ItemListOrderAscending;
    schema:itemListElement <#loc1>, <#loc2>, <#loc3>.
<#loc1> a schema:ListItem;
    schema:name "Alice's Pod";
    schema:item <https://alice.solidcommunity.net/>;
    schema:position 1.
<#loc2> a schema:ListItem;
    schema:name "Team Pod";
    schema:item <https://pod.example/team/>;
    schema:position 2.
<#loc3> a schema:ListItem;
    schema:name "Local Data Kitchen Pod";
    schema:item <http://localhost:8000/dk-pod/>;
    schema:position 3.
